# Copiar valores en Coolify → Environment Variables

ADMIN_PASSWORD=cambia_esta_clave
DATABASE_URL=sqlite:////data/eca360.db
UPLOAD_DIR=/data/uploads

# Front en Cloudflare
CORS_ORIGINS=https://eca360-page.pages.dev,https://eca360.com.mx,https://www.eca360.com.mx,http://localhost:5173,http://127.0.0.1:5173
APP_URL=https://eca360.com.mx
API_URL=https://api.eca360.com.mx
APP_NAME=ECA MID

HOST=0.0.0.0
PORT=8000

# WebP al subir (la web sirve WebP; GET /download → PNG para el cliente)
WEBP_QUALITY=85

# Media storage: local (disco del VPS) | r2 (Cloudflare R2 — uploads nuevos)
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eca360-media
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
