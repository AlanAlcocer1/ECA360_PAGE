# Database — use SQLite for local/dev or PostgreSQL for production
DATABASE_URL=sqlite:///./eca360.db
# DATABASE_URL=postgresql://user:password@localhost:5432/eca360

# Admin password (simple session auth — no JWT)
ADMIN_PASSWORD=eca360admin

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=200
WEBP_QUALITY=85

# Storage: local | r2
STORAGE_BACKEND=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=eca360-media
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# App
APP_NAME=ECA360 Eventos
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
