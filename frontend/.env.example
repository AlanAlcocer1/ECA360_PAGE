# URL base del backend FastAPI (sin slash final).
#
# Local (npm run dev): vacío → http://localhost:8000
# Producción (Cloudflare Pages): /__api (proxy same-origin → Coolify)
# Directo al API (si CORS_ORIGINS ya incluye el origen del front):
#   VITE_API_URL=https://api.eca360.com.mx
#
# VITE_API_URL=http://localhost:8000
# VITE_API_URL=/__api
VITE_API_URL=
